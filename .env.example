# Generate a long random value for production. Never commit your real .env file.
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///candidate_reviews.db

# First-run admin account (created only if no admin exists)
ADMIN_NAME=System Admin
ADMIN_EMAIL=viji1210@example.com
ADMIN_PASSWORD=viji1234@

# SMTP email (optional; notifications are skipped if not configured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
SMTP_PASSWORD=your-google-app-password
MAIL_FROM=your-account@gmail.com

# Google Calendar API (optional). Configure OAuth credentials and token flow before enabling.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=primary
GOOGLE_TIMEZONE=Asia/Kolkata
GOOGLE_CLIENT_SECRET_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# OpenAI (optional; AI outputs are suggestions and must be human-approved)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
